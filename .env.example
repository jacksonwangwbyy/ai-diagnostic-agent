# === LLM API Keys ===
ANTHROPIC_API_KEY=your-claude-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# === API Base URLs (中转站配置) ===
# 如果使用中转站/代理，填入中转站地址
# Anthropic 不带 /v1（SDK 会自动拼接）
ANTHROPIC_BASE_URL=https://your-proxy.com
# OpenAI 带 /v1
OPENAI_BASE_URL=https://your-proxy.com/v1

# === Default Model ===
# Options: claude, openai
DEFAULT_LLM_PROVIDER=claude
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o

# === Log Read Mode ===
# "local" = 直接读本地文件（同机部署时使用）
# "ssh"   = 通过 SSH 远程读取（跨机部署时使用）
LOG_READ_MODE=local

# === SSH Device Access (仅 LOG_READ_MODE=ssh 时需要) ===
DEVICE_SSH_HOST=192.168.42.1
DEVICE_SSH_USER=smyze
DEVICE_SSH_KEY_PATH=~/.ssh/id_rsa

# === Vector Database ===
# Options: chromadb, milvus
VECTOR_DB_TYPE=chromadb
CHROMA_PERSIST_DIR=./chroma_data
# Milvus（生产环境使用，VECTOR_DB_TYPE=milvus 时生效）
MILVUS_HOST=localhost
MILVUS_PORT=19530

# === Bar Middleware（同机部署，直接 localhost）===
MIDDLEWARE_BASE_URL=http://localhost:8003

# === Bar Deploy Server ===
BAR_DEPLOY_SERVER_URL=http://localhost:8080

# === Redis（对话历史持久化）===
# 留空或不配置则使用内存存储（开发模式）
REDIS_URL=redis://localhost:6379/0
# 会话过期时间（秒），默认 3600 = 1小时
SESSION_TTL=3600

# === LLM Fallback ===
# 主 provider 失败时自动切换到备用 provider（true/false）
LLM_FALLBACK_ENABLED=true
