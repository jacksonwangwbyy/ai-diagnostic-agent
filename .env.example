# === LLM API Keys ===
ANTHROPIC_API_KEY=your-claude-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# === Default Model ===
# Options: claude, openai
DEFAULT_LLM_PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o

# === SSH Device Access ===
DEVICE_SSH_HOST=192.168.42.1
DEVICE_SSH_USER=smyze
DEVICE_SSH_KEY_PATH=~/.ssh/id_rsa

# === Vector Database ===
# Options: chromadb, milvus
VECTOR_DB_TYPE=chromadb
CHROMA_PERSIST_DIR=./chroma_data
# Milvus (Phase 4)
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# === Bar Deploy Server ===
BAR_DEPLOY_SERVER_URL=http://localhost:8080
